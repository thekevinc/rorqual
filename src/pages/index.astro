---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Tile from '../components/Tile.astro';
---

<Layout>
  <main class="container">
    <Hero />

    <section class="tiles-section">
      <div class="section-head">
        <h2 class="mono">// PROJECTS</h2>
        <span class="dim mono count">003</span>
      </div>

      <div class="grid">
        <Tile
          href="/rent-vs-mortgage"
          title="Rent vs Mortgage"
          blurb="Stop guessing. Plug in your numbers and see when buying actually pencils out vs renting and investing the difference."
          status="live"
          external={false}
        />
        <Tile
          href="https://whale-watch.example.com"
          title="Whale Watch"
          blurb="Tracks $50k+ traders across Polymarket prediction markets to surface where serious capital is taking sides."
          status="beta"
        />
        <Tile
          href="#"
          title="Untitled · Next"
          blurb="Something I'm prototyping. Maybe a portfolio rebalancer, maybe a tax-loss harvester. We'll see."
          status="soon"
        />
      </div>
    </section>

    <footer class="footer">
      <div class="footer-row">
        <span class="mono faint">© 2026 · KEVIN CURTIN</span>
        <a class="link mono" href="https://x.com/me_kevin_c" target="_blank" rel="noopener noreferrer">
          @ME_KEVIN_C
        </a>
      </div>
    </footer>
  </main>
</Layout>

<style>
  .tiles-section {
    margin-top: 2rem;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .section-head h2 {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    font-weight: 500;
  }

  .count {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }

  .footer {
    margin-top: 6rem;
    padding: 2rem 0;
    border-top: 1px solid var(--border);
  }

  .footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
  }

  .link {
    color: var(--text-dim);
    transition: color 150ms ease;
  }

  .link:hover {
    color: var(--accent);
  }
</style>
