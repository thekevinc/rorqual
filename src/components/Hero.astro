---
// Wordmark + tagline. "Rorqual" = a family of whales (blue, fin, humpback...).
// The "·" dividers riff on a Bloomberg-terminal ticker bar.
---

<section class="hero">
  <p class="kicker mono">RORQUAL</p>
  <h1>
    Tools for thinking about <span class="accent">money</span>
    and
    <span class="accent">markets</span>
  </h1>
  <p class="lede dim">
    A small, deliberately-built collection of analyzers to get you alpha
  </p>
</section>

<style>
  .hero {
    padding: 6rem 0 4rem;
  }

  .kicker {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: var(--text-faint);
    margin-bottom: 2rem;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 6vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    max-width: 18ch;
    margin-bottom: 1.5rem;
  }

  h1 .accent {
    font-style: italic;
    font-weight: 400;
  }

  .lede {
    font-size: 1.05rem;
    max-width: 52ch;
  }
</style>
